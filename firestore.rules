rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Visitors may submit feedback; only signed-in users can read/manage it.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasAll(['name','rating','category','message','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.message is string && request.resource.data.message.size() <= 1200
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow read, update, delete: if request.auth != null;
    }
    // Starter rules only. Add stricter field/type validation before real business use.
    match /orders/{id} {
      allow create: if request.resource.data.keys().hasAll(['customerName','contact','items','total','createdAt','requestedAt']);
      allow read, update, delete: if request.auth != null;
    }
    match /bookings/{id} {
      allow create: if request.resource.data.keys().hasAll(['customerName','email','bookingType','date','time','createdAt']);
      allow read, update, delete: if request.auth != null;
    }
  }
}
